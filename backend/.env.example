PORT=5000
# MongoDB Atlas (or local) connection string
MONGODB_URI=mongodb://127.0.0.1:27017/leave_management
# Long random string
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated list of allowed frontend origins (your GitHub Pages URL), no trailing slash
CORS_ORIGIN=http://localhost:5500,https://figurerevitalization.github.io
# Create demo users on first start when DB is empty (set to false in production)
SEED_DEMO=true
